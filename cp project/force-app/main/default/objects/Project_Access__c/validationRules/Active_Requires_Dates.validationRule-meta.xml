<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Requires_Dates</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Access_Status__c, "Active"), OR(ISBLANK(Start_Date__c), ISBLANK(End_Date__c)))</errorConditionFormula>
    <errorMessage>Start Date and End Date are mandatory when Access Status is Active.</errorMessage>
</ValidationRule>
