<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Receipt_Amount_Must_Be_Non_Negative</fullName>
    <active>true</active>
    <description>Protects the receipt ledger from negative values.</description>
    <errorConditionFormula>Amount__c &lt; 0</errorConditionFormula>
    <errorMessage>Receipt amount cannot be negative.</errorMessage>
</ValidationRule>
