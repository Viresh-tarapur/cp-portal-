<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Remarks_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Payment_Status__c, &quot;Failed&quot;),
        ISPICKVAL(Payment_Status__c, &quot;Refunded&quot;)
    ),
    ISBLANK(Remarks__c)
)</errorConditionFormula>
    <errorMessage>Please enter remarks for failed or refunded payments.</errorMessage>
</ValidationRule>
