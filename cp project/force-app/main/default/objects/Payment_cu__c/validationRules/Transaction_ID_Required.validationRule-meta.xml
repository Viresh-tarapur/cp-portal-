<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Transaction_ID_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Payment_Status__c, &quot;Successful&quot;),
    ISBLANK(Transaction_ID__c)
)</errorConditionFormula>
    <errorMessage>Transaction ID is required for successful payments.</errorMessage>
</ValidationRule>
