<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Mode_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Amount__c &gt; 0,
    ISBLANK(TEXT(Payment_Mode__c))
)</errorConditionFormula>
    <errorMessage>Please select a Payment Mode.</errorMessage>
</ValidationRule>
