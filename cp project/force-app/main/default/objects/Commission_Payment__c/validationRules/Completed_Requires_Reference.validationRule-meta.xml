<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Requires_Reference</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Completed"), ISBLANK(Payment_Reference__c))</errorConditionFormula>
    <errorMessage>Payment Reference (UTR) is required for completed payouts.</errorMessage>
</ValidationRule>
