<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Launch_Before_Completion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Launch_Date__c)), NOT(ISBLANK(Completion_Date__c)), Completion_Date__c &lt; Launch_Date__c)</errorConditionFormula>
    <errorMessage>Completion Date cannot precede Launch Date.</errorMessage>
</ValidationRule>
