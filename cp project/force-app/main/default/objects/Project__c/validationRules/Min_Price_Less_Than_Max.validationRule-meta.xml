<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Min_Price_Less_Than_Max</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Minimum_Price__c)), NOT(ISBLANK(Maximum_Price__c)), Minimum_Price__c > Maximum_Price__c)</errorConditionFormula>
    <errorMessage>Minimum Price cannot exceed Maximum Price.</errorMessage>
</ValidationRule>
