<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approval_Requires_KYC_Approved</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Approved"), NOT(ISPICKVAL(KYC_Status__c, "Approved")))</errorConditionFormula>
    <errorMessage>Cannot approve Channel Partner until KYC status is Approved.</errorMessage>
</ValidationRule>
