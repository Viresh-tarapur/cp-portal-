<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Document_Status__c, "Rejected"), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
    <errorMessage>Rejection reason is required when rejecting a KYC document.</errorMessage>
</ValidationRule>
