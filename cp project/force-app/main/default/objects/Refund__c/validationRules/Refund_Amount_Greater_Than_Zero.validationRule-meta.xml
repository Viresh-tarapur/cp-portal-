<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Refund_Amount_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>Refund Amount must be greater than zero.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Amount__c)), Amount__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Refund Amount must be greater than zero.</errorMessage>
</ValidationRule>
