<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Visit_Requires_Outcome</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Completed"), ISBLANK(TEXT(Visit_Outcome__c)))</errorConditionFormula>
    <errorMessage>Visit outcome is required when completing a site visit.</errorMessage>
</ValidationRule>
