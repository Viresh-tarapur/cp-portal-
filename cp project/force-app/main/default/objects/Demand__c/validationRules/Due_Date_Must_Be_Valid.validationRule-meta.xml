<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_Must_Be_Valid</fullName>
    <active>true</active>
    <description>Demand Due Date cannot be earlier than Demand Date.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Due_Date__c)), NOT(ISBLANK(Demand_Date__c)), Due_Date__c &lt; Demand_Date__c)</errorConditionFormula>
    <errorDisplayField>Due_Date__c</errorDisplayField>
    <errorMessage>Demand Due Date cannot be earlier than Demand Date.</errorMessage>
</ValidationRule>
