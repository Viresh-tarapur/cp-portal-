<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Approval_Requires_Eligibility</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Approval_Status__c, "Approved"), NOT(ISPICKVAL(Eligibility_Status__c, "Eligible")))</errorConditionFormula>
    <errorMessage>Cannot approve commission until eligibility status is Eligible.</errorMessage>
</ValidationRule>
