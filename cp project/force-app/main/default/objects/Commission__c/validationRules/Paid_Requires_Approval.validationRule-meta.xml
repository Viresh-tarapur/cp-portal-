<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Requires_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Payment_Status__c, "Paid"), NOT(ISPICKVAL(Approval_Status__c, "Approved")))</errorConditionFormula>
    <errorMessage>Payment cannot be marked Paid until Commission is Approved.</errorMessage>
</ValidationRule>
