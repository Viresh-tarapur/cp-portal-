<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Bank_Name_Required_When_Loan_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Loan_Required__c = TRUE,
    ISBLANK(Bank_Name__c)
)</errorConditionFormula>
    <errorMessage>Please enter the Bank Name when Loan Required is selected.</errorMessage>
</ValidationRule>
