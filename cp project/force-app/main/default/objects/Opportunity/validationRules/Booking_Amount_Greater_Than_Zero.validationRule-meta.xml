<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Booking_Amount_Greater_Than_Zero</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Booking_Amount__c)), Booking_Amount__c &lt;= 0)</errorConditionFormula>
    <errorMessage>Booking Amount must be greater than zero.</errorMessage>
</ValidationRule>
