<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Project_Required_When_Qualified</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Qualified&quot;),
    ISBLANK(Project__c)
)</errorConditionFormula>
    <errorMessage>Please select a Project before qualifying the Lead.</errorMessage>
</ValidationRule>
