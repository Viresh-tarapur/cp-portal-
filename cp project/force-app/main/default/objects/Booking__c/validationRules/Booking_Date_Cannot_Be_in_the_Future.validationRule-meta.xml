<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Booking_Date_Cannot_Be_in_the_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Booking_Date__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Booking Date cannot be a future date.</errorMessage>
</ValidationRule>
