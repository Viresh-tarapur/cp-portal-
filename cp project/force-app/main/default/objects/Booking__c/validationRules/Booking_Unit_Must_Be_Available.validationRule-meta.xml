<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Booking_Unit_Must_Be_Available</fullName>
    <active>true</active>
    <description>Ensures that the selected Unit has Status Available before a Booking can be created.</description>
    <errorConditionFormula>AND(
    ISNEW(),
    NOT(ISBLANK(Unit__c)),
    TEXT(Unit__r.Status__c) != &apos;Available&apos;
)</errorConditionFormula>
    <errorDisplayField>Unit__c</errorDisplayField>
    <errorMessage>Selected Unit is not available.</errorMessage>
</ValidationRule>
