<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Automatically approves partner and activates commission eligibility when KYC verification is completed.</description>
    <environments>Default</environments>
    <interviewLabel>CP Partner KYC Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CP Partner KYC Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Approve_Partner_Record</name>
        <label>Approve Partner Record</label>
        <locationX>150</locationX>
        <locationY>250</locationY>
        <inputAssignments>
            <field>Commission_Eligible__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Approve_Partner_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>KYC_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Partner__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
